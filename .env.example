APP_ENV=development
LOG_LEVEL=INFO

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Hosted LLM Provider (e.g. OpenRouter)
# LLM_PROVIDER=hosted
# HOSTED_LLM_URL=https://openrouter.ai/api/v1
# HOSTED_LLM_MODEL=openrouter/free
# HOSTED_LLM_API_KEY=your_api_key_here

DATABASE_URL=sqlite:///./vera.db

HOST=0.0.0.0
PORT=8080

LLM_TIMEOUT=30
VALIDATION_MAX_RETRIES=1

ENABLE_LANGGRAPH=true
ENABLE_VECTOR_RAG=false